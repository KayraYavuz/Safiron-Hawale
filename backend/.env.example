# Hawala System — Production Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Database
DATABASE_URL=postgresql://hawala_user:STRONG_PASSWORD@localhost:5432/hawala_db

# JWT — Güvenli, uzun bir secret key kullanın (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — Production'da frontend URL'nizi girin (virgülle ayırın)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
